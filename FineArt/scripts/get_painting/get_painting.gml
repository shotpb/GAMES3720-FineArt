function get_painting(painting_choice){
	switch (painting_choice) {
		case 1:
			return Painting_1;
		case 2:
			return Painting_2;
		case 3:
			return Painting_3;
		case 4:
			return Painting_4;
		case 5:
			return Painting_5;
		case 6:
			return Painting_6;
		case 7:
			return Painting_7;
		case 8:
			return Painting_8;
		case 9:
			return Painting_9;
		case 10:
			return Painting_10;
		default:
			return Painting_1;
	}
}